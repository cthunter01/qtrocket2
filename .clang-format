BasedOnStyle: Google
AccessModifierOffset: -4
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignConsecutiveDeclarations: Consecutive
AllowShortFunctionsOnASingleLine: Inline
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: false
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyNamespace: false
  SplitEmptyRecord: false
BracedInitializerIndentWidth: -1
BreakBeforeBraces: Custom
ColumnLimit: 100
ConstructorInitializerIndentWidth: 2
Cpp11BracedListStyle: AlignFirstComment
IndentCaseBlocks: false
IndentWidth: 4
InsertBraces: true
LambdaBodyIndentation: Signature
RemoveBracesLLVM: false
SpaceInEmptyBraces: Always
TabWidth: 4
# Include order after the file's own header: C headers, standard library, Qt, other third-party, this project.
# The header under test stays the first include of MyClassTests.cpp / name_tests.cpp. Only the project's own
# suffixes are recognised (not Google's _test/_unittest), so a misnamed test file is visibly formatted differently.
# The categories are case-sensitive: Qt's <QWidget> is no standard header, nor <QtCore/qobject.h> a C header.
IncludeIsMainRegex: '(_tests|Tests)?$'
IncludeCategories:
  - Regex: '^<(Qt[A-Za-z]*/)?Q[A-Za-z0-9_]*>$|^<Qt[A-Za-z]+/q[a-z0-9_]*\.h>$'
    Priority: 3
    CaseSensitive: true
  - Regex: '^<(sys/)?[a-z0-9_]+\.h>$'
    Priority: 1
    CaseSensitive: true
  - Regex: '^<[a-z0-9_]+>$'
    Priority: 2
    CaseSensitive: true
  - Regex: '^<'
    Priority: 4
  - Regex: '^"'
    Priority: 5

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- QtRocket test fixture (README.md): a body tube with a base64 thumbnail, thumbnail.png, in
     place of BaseComponentDTOTest's round trip of an image through OpenRocket's .orc saver. -->
<OpenRocketComponent>
    <Version>0.1</Version>
    <Materials/>
    <Components>
        <BodyTube>
            <Manufacturer>manufacturer</Manufacturer>
            <PartNumber>partno</PartNumber>
            <Mass Unit="kg">100.0</Mass>
            <Thumbnail>iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAE0lEQVR42mP4z8DwHwyBNAg0AABJSQl4nFEXkgAAAABJRU5ErkJggg==</Thumbnail>
            <InsideDiameter Unit="m">1.0</InsideDiameter>
            <OutsideDiameter Unit="m">2.0</OutsideDiameter>
            <Length Unit="m">2.0</Length>
        </BodyTube>
    </Components>
</OpenRocketComponent>

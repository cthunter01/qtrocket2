<?xml version='1.0' encoding='utf-8'?>
<openrocket version="1.11" creator="OpenRocket 26.xx-SNAPSHOT-5f164fd0e">
  <rocket>
    <name>Rocket</name>
    <id>07a4895e-aefd-492e-8872-085bf40b1638</id>
    <axialoffset method="absolute">0.0</axialoffset>
    <position type="absolute">0.0</position>
    <comment>A two stage rocket with 38mm motor mounts.  The intent is the interstage would contain a flight computer capable of a single ejection, and ignition of the second stage motor.  A second flight computer in the sustainer handles a dual deploy recovery for the sustainer.</comment>
    <designer>Joe Pfeiffer</designer>
    <designtype>original</designtype>
    <motorconfiguration configid="cf7a0b8c-19e9-4112-912f-505bc8e01067" default="true">
      <name>[H148R-0; H148R-0]</name>
      <stage number="0" active="true"/>
      <stage number="1" active="true"/>
    </motorconfiguration>
    <motorconfiguration configid="fadeeef3-4aa4-49e9-9581-71e14fa91c14">
      <name>[I59WN-P; I357T-14]</name>
      <stage number="0" active="true"/>

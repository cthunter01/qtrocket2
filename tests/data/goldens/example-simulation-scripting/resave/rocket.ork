          <standarddeviation>0.2</standarddeviation>
        </wind>
        <wind model="multilevel" altituderef="msl">
          <windlevel altitude="0.0" speed="3.8" direction="3.0892327760299634" standarddeviation="1.52"/>
        </wind>
        <windmodeltype>Average</windmodeltype>

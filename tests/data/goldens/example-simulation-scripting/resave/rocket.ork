        <launchlatitude>45.0</launchlatitude>
        <launchlongitude>0.0</launchlongitude>
        <geodeticmethod>flat</geodeticmethod>
        <simulationsteppermethod>rk4</simulationsteppermethod>
        <atmosphere model="isa"/>
        <gravity model="wgs"/>
        <timestep>0.05</timestep>

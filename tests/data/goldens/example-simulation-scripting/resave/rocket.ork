      <extension extensionid="info.openrocket.core.simulation.extension.impl.ScriptingExtension">
        <entry key="language" type="string">JavaScript</entry>
        <entry key="script" type="string">var Coordinate = Java.type(&quot;net.sf.openrocket.util.Coordinate&quot;);
// launch altitude
const ALTITUDE = 100.0;

// launch velocity
const VELOCITY = 50.0;

function startSimulation(status) {
	status.setRocketPosition(new Coordinate(0, 0, ALTITUDE));
	status.setRocketVelocity(new Coordinate(0, 0, VELOCITY));
}
</entry>

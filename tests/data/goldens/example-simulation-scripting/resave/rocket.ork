        <entry key="language" type="string">JavaScript</entry>
        <entry key="script" type="string">// Name of control fin set
const CONTROL_FIN_NAME = &quot;CONTROL&quot;;

// Desired roll rate (rad/sec)
const SETPOINT = 0 * Math.PI / 180;

// Maximum control fin angle (rad)
const MAX_ANGLE = 15 * Math.PI / 180;

// PID parameters
const KP = 0.007;
const KI = 0.2;

////////////////////////////////////////

var rollrate = 0;
var previousTime = 0;
var intState = 0;

function postFlightConditions(status, flightConditions) {
	// Store the current roll rate for later use
	rollrate = flightConditions.getRollRate();
}

function postStep(status) {
	const controlFin = findControlFin(status);
	const deltaT = status.getSimulationTime() - previousTime;
	previousTime = status.getSimulationTime();
	
	const error = SETPOINT - rollrate;
	intState += error * deltaT;

	const p = KP * error;
	const i = KI * intState;
	let value = p + i;

	// Clamp to -MAX_ANGLE .. MAX_ANGLE
	if (value &gt; MAX_ANGLE) {
		value = MAX_ANGLE;
	}
	if (value &lt; -MAX_ANGLE) {
		value = -MAX_ANGLE;
	}

	controlFin.setCantAngle(value);
}

function findControlFin(status) {
	let component;
	const iterator = status.getConfiguration().getAllComponents().iterator();
	while (iterator.hasNext()) {
		component = iterator.next();
		if (component.getName() == CONTROL_FIN_NAME) {
			return component;
		}
	}
	throw &quot;Could not find fin with name &quot; + CONTROL_FIN_NAME;
}
</entry>

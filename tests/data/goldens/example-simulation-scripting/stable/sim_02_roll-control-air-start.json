   "id": "info.openrocket.core.simulation.extension.impl.ScriptingExtension",
   "type": "ScriptingExtension",
   "name": "JavaScript script",
   "config": {"enabled": false, "language": "JavaScript", "script": "// Name of control fin set\nconst CONTROL_FIN_NAME = \"CONTROL\";\n\n// Desired roll rate (rad/sec)\nconst SETPOINT = 0 * Math.PI / 180;\n\n// Maximum control fin angle (rad)\nconst MAX_ANGLE = 15 * Math.PI / 180;\n\n// PID parameters\nconst KP = 0.007;\nconst KI = 0.2;\n\n////////////////////////////////////////\n\nvar rollrate = 0;\nvar previousTime = 0;\nvar intState = 0;\n\nfunction postFlightConditions(status, flightConditions) {\n\t// Store the current roll rate for later use\n\trollrate = flightConditions.getRollRate();\n}\n\nfunction postStep(status) {\n\tconst controlFin = findControlFin(status);\n\tconst deltaT = status.getSimulationTime() - previousTime;\n\tpreviousTime = status.getSimulationTime();\n\t\n\tconst error = SETPOINT - rollrate;\n\tintState += error * deltaT;\n\n\tconst p = KP * error;\n\tconst i = KI * intState;\n\tlet value = p + i;\n\n\t// Clamp to -MAX_ANGLE .. MAX_ANGLE\n\tif (value > MAX_ANGLE) {\n\t\tvalue = MAX_ANGLE;\n\t}\n\tif (value < -MAX_ANGLE) {\n\t\tvalue = -MAX_ANGLE;\n\t}\n\n\tcontrolFin.setCantAngle(value);\n}\n\nfunction findControlFin(status) {\n\tlet component;\n\tconst iterator = status.getConfiguration().getAllComponents().iterator();\n\twhile (iterator.hasNext()) {\n\t\tcomponent = iterator.next();\n\t\tif (component.getName() == CONTROL_FIN_NAME) {\n\t\t\treturn component;\n\t\t}\n\t}\n\tthrow \"Could not find fin with name \" + CONTROL_FIN_NAME;\n}\n"}
  },
  {
   "id": "info.openrocket.core.simulation.extension.impl.ScriptingExtension",
   "type": "ScriptingExtension",
   "name": "JavaScript script",
   "config": {"enabled": false, "language": "JavaScript", "script": "var Coordinate = Java.type(\"net.sf.openrocket.util.Coordinate\");\n// launch altitude\nconst ALTITUDE = 100.0;\n\n// launch velocity\nconst VELOCITY = 50.0;\n\nfunction startSimulation(status) {\n\tstatus.setRocketPosition(new Coordinate(0, 0, ALTITUDE));\n\tstatus.setRocketVelocity(new Coordinate(0, 0, VELOCITY));\n}\n"}
  }

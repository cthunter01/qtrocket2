<?xml version='1.0' encoding='utf-8'?>
<openrocket version="1.11" creator="OpenRocket 26.xx-SNAPSHOT-5f164fd0e">
  <rocket>
    <name>Booster Rocket</name>
    <id>6dfadb03-6a13-4f65-866d-44e847039cc5</id>
    <axialoffset method="absolute">0.0</axialoffset>
    <position type="absolute">0.0</position>
    <comment>Example Rocket showing Parallel (booster) Stages

Boosters typically:
- contain motors
- separate during flight, like stages
</comment>
    <designer>Daniel Williams
On GitHub: teyrana
equipoise@gmail.com</designer>
    <designtype>original</designtype>
    <motorconfiguration configid="29da32d7-f902-4192-8389-c11b6c360807" default="true">
      <stage number="0" active="true"/>
      <stage number="1" active="true"/>
      <stage number="2" active="true"/>
    </motorconfiguration>
    <referencetype>maximum</referencetype>

    <subcomponents>

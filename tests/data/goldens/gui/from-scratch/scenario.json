{
  "schema": "gui-from-scratch-scenario",
  "schemaVersion": 1,
  "title": "A rocket designed from scratch in the GUI",
  "steps": [
    {"step": "new", "note": "File > New: a new design window; its sustainer is selected"},
    {"step": "select", "paths": [["Sustainer"]]},

    {"step": "add", "component": "NoseCone"},
    {"step": "choose", "field": "ShapeType", "item": "ELLIPSOID"},
    {"step": "type", "field": "Length", "text": "10", "unit": "cm"},
    {"step": "check", "field": "BaseRadiusAutomatic", "checked": true, "note": "the Automatic check box of the base diameter"},
    {"step": "type", "field": "Thickness", "text": "0.15", "unit": "cm"},
    {"step": "choose", "field": "Material", "item": "Polycarbonate (Lexan)"},
    {"step": "choose", "field": "Finish", "item": "SMOOTH"},
    {"step": "ok"},

    {"step": "add", "component": "BodyTube", "note": "the nose cone is selected and last in the stage: the tube goes after it"},
    {"step": "type", "field": "Length", "text": "30", "unit": "cm"},
    {"step": "type", "field": "OuterRadius", "text": "4.1", "unit": "cm", "note": "the field shows the outer diameter"},
    {"step": "type", "field": "Thickness", "text": "0.05", "unit": "cm"},
    {"step": "ok"},

    {"step": "add", "component": "TrapezoidFinSet", "note": "the body tube is selected: the fins go into it"},
    {"step": "type", "field": "FinCount", "text": "4"},
    {"step": "type", "field": "RootChord", "text": "7", "unit": "cm"},
    {"step": "type", "field": "TipChord", "text": "3.5", "unit": "cm"},
    {"step": "type", "field": "Height", "text": "5.5", "unit": "cm"},
    {"step": "type", "field": "Sweep", "text": "4", "unit": "cm"},
    {"step": "type", "field": "Thickness", "text": "3", "unit": "mm"},
    {"step": "choose", "field": "CrossSection", "item": "ROUNDED"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "InnerTube"},
    {"step": "type", "field": "Length", "text": "7.5", "unit": "cm"},
    {"step": "type", "field": "OuterRadius", "text": "2.6", "unit": "cm", "note": "the outer diameter"},
    {"step": "type", "field": "InnerRadius", "text": "2.4", "unit": "cm", "note": "the inner diameter"},
    {"step": "check", "field": "MotorMount", "checked": true, "note": "the Motor tab: This component is a motor mount"},
    {"step": "type", "field": "MotorOverhang", "text": "0.5", "unit": "cm"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "CenteringRing"},
    {"step": "type", "field": "Name", "text": "Fore centering ring"},
    {"step": "type", "field": "Length", "text": "0.3", "unit": "cm", "note": "the field labelled Thickness"},
    {"step": "choose", "field": "AxialMethod", "item": "BOTTOM"},
    {"step": "type", "field": "AxialOffset", "text": "-6", "unit": "cm"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "CenteringRing"},
    {"step": "type", "field": "Name", "text": "Aft centering ring"},
    {"step": "type", "field": "Length", "text": "0.3", "unit": "cm"},
    {"step": "choose", "field": "AxialMethod", "item": "BOTTOM"},
    {"step": "type", "field": "AxialOffset", "text": "-0.5", "unit": "cm"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "Parachute"},
    {"step": "type", "field": "Diameter", "text": "30", "unit": "cm"},
    {"step": "type", "field": "LineCount", "text": "8"},
    {"step": "type", "field": "AxialOffset", "text": "2", "unit": "cm"},
    {"step": "choose", "field": "DeployEvent", "item": "ALTITUDE"},
    {"step": "type", "field": "DeployAltitude", "text": "150", "unit": "m"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "ShockCord"},
    {"step": "type", "field": "CordLength", "text": "60", "unit": "cm"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "LaunchLug"},
    {"step": "type", "field": "Length", "text": "5", "unit": "cm"},
    {"step": "type", "field": "AngleOffset", "text": "180", "unit": "°"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "RailButton"},
    {"step": "type", "field": "InstanceCount", "text": "2"},
    {"step": "type", "field": "InstanceSeparation", "text": "15", "unit": "cm"},
    {"step": "type", "field": "AngleOffset", "text": "90", "unit": "°"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "add", "component": "MassComponent"},
    {"step": "type", "field": "Name", "text": "Altimeter"},
    {"step": "choose", "field": "MassComponentType", "item": "ALTIMETER"},
    {"step": "type", "field": "ComponentMass", "text": "15", "unit": "g"},
    {"step": "type", "field": "AxialOffset", "text": "8", "unit": "cm"},
    {"step": "ok"},

    {"step": "select", "paths": [["Sustainer", "Body Tube", "Trapezoidal Fin Set"]]},
    {"step": "edit", "note": "Edit > Edit (or a double click on the row): the fin set's dialog"},
    {"step": "button", "button": "convertToFreeform", "note": "Convert to freeform: the dialog of the freeform fin set opens"},
    {"step": "editPoint", "row": 1, "column": "X", "text": "3", "unit": "cm"},
    {"step": "insertPoint", "row": 2},
    {"step": "editPoint", "row": 3, "column": "Y", "text": "3", "unit": "cm"},
    {"step": "ok"},

    {"step": "undo"},
    {"step": "redo"},

    {"step": "select", "paths": [["Sustainer", "Body Tube", "Parachute"]]},
    {"step": "copy"},
    {"step": "select", "paths": [["Sustainer", "Body Tube"]]},
    {"step": "paste", "note": "the body tube takes a parachute: the copy goes in last"},
    {"step": "select", "paths": [["Sustainer", "Body Tube", {"name": "Parachute", "occurrence": 2}]]},
    {"step": "edit"},
    {"step": "type", "field": "Name", "text": "Drogue"},
    {"step": "type", "field": "Diameter", "text": "15", "unit": "cm"},
    {"step": "ok"},

    {"step": "saveAs", "note": "File > Save as: the design information dialog first"},
    {"step": "type", "field": "Designer", "text": "QtRocket exit scenario"},
    {"step": "ok"},
    {"step": "chooseFile", "file": "rocket", "note": "typed without the extension, which Save as adds"}
  ]
}

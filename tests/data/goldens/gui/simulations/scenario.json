{
  "schema": "gui-scenario",
  "schemaVersion": 3,
  "title": "Simulations of the flight-configurations design in the Flight simulations tab",
  "steps": [
    {"step": "open", "file": "tests/data/goldens/gui/flight-configurations/rocket.ork", "note": "OpenRocket's save of the flight-configurations scenario: three configurations, three simulations without data"},
    {"step": "tab", "tab": "simulations", "note": "the table takes the focus, its first row selected"},

    {"step": "editSimulation", "answer": {"edits": [
      {"name": "Simulation 1 - wind levels"},
      {"windModel": "MULTI_LEVEL"},
      {"windLevels": {"edits": [
        {"addLevel": true},
        {"cell": {"row": 1, "column": "speed", "text": "6"}},
        {"addLevel": true},
        {"cell": {"row": 2, "column": "altitude", "text": "50"}},
        {"columnUnit": {"column": "altitude", "unit": "ft"}},
        {"deleteLevel": 1},
        {"altitudeReference": "AGL"}
      ], "button": "close"}},
      {"field": "LaunchRodLength", "text": "1.5", "unit": "m"},
      {"field": "LaunchIntoWind", "checked": false}
    ], "button": "ok", "run": {"button": "cancel"}}, "note": "the multi-level wind edited in the wind editor; OK runs the outdated simulation, whose run dialog is cancelled before it starts"},

    {"step": "selectSimulations", "rows": [{"row": 1}]},
    {"step": "editSimulation", "answer": {"edits": [
      {"field": "SimulationStepperMethodChoice", "item": "RK6"},
      {"field": "GeodeticComputation", "item": "WGS84"},
      {"field": "GravityModelType", "item": "CONSTANT"},
      {"field": "ConstantGravity", "text": "9.8", "unit": "m/s²"},
      {"field": "TimeStep", "text": "0.02", "unit": "s"},
      {"field": "MaxSimulationTime", "text": "600", "unit": "s"},
      {"randomSeed": {"fixed": true, "text": "12345"}},
      {"field": "RecoverySpeedWarning", "text": "25", "unit": "m/s"},
      {"lookup": {"drag": [
        {"load": {"file": "tests/data/goldens/gui/simulations/drag.csv", "button": "open"}},
        {"text": "Mach,Cd\n0.1,0.41\n0.5,0.43\n0.9,0.56"}
      ], "button": "ok"}},
      {"field": "ISAAtmosphere", "checked": false},
      {"field": "LaunchTemperature", "text": "20", "unit": "°C"}
    ], "button": "ok", "run": {"button": "cancel"}}},
    {"step": "editSimulation", "answer": {"edits": [
      {"field": "LaunchAltitude", "text": "300", "unit": "m"}
    ], "button": "cancel", "discard": {"button": "yes"}}, "note": "Cancel discards the change"},

    {"step": "newSimulation", "answer": {"edits": [{"name": "Simulation 4 - new"}], "button": "ok", "run": {"button": "cancel"}}},
    {"step": "duplicateSimulations"},
    {"step": "copySimulations"},
    {"step": "selectSimulations", "rows": [{"row": 0}]},
    {"step": "pasteSimulations", "note": "after the selected row"},
    {"step": "deleteSimulations", "answer": {"button": "ok", "doNotAskAgain": true}, "note": "the pasted simulation, which Paste selected"},
    {"step": "selectSimulations", "rows": [{"row": 3}, {"row": 4, "with": "ctrl"}]},
    {"step": "cutSimulations", "note": "no confirmation any more"},
    {"step": "undo"},
    {"step": "redo"},
    {"step": "columnVisibility", "column": "simulationStepper", "visible": true},
    {"step": "columnVisibility", "column": "apogee", "visible": false},

    {"step": "editSimulation", "answer": {"edits": [
      {"windLevels": {"edits": [
        {"importLevels": {"settings": {"button": "ok"}, "file": {"file": "tests/data/goldens/gui/simulations/wind-levels.csv", "button": "open"}, "overwrite": {"button": "yes"}}}
      ], "button": "close"}}
    ], "button": "ok", "run": {"button": "cancel"}}},
    {"step": "editSimulation", "answer": {"edits": [
      {"windLevels": {"edits": [
        {"resetLevels": {"button": "no"}},
        {"importLevels": {"settings": {"separator": " ", "columns": {"altitude": {"unit": "ft"}}, "button": "ok"}, "file": {"file": "tests/data/goldens/gui/simulations/wind-levels-space.csv", "button": "open"}, "overwrite": {"button": "yes"}}}
      ], "button": "close"}}
    ], "button": "ok", "run": {"button": "cancel"}}, "note": "a SPACE separator (bug 34)"},

    {"step": "selectSimulations", "rows": [{"row": 1}]},
    {"step": "editSimulation", "answer": {"edits": [
      {"lookup": {"drag": [{"clear": true}], "button": "ok"}}
    ], "button": "ok", "run": {"button": "cancel"}}, "note": "the lookup table cleared before Save as"},
    {"step": "newSimulation", "answer": {"button": "cancel", "discard": {"button": "yes", "doNotAskAgain": true}}},

    {"step": "saveAs"},
    {"step": "type", "field": "Designer", "text": "QtRocket simulations"},
    {"step": "ok"},
    {"step": "chooseFile", "file": "rocket"}
  ]
}

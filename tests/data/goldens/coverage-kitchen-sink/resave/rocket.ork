    <lightAz>-1.0</lightAz>
    <lightStrength>0.8</lightStrength>
    <sunlight red="255" green="250" blue="240" alpha="255"/>
    <ambiance>0.3</ambiance>
    <skyColor red="55" green="95" blue="155" alpha="255"/>
    <backgroundType>GRADIENT</backgroundType>
    <gradientTopColor red="1" green="2" blue="3" alpha="255"/>
    <gradientBottomColor red="4" green="5" blue="6" alpha="128"/>
    <motionBlurred>true</motionBlurred>
    <motionBlurAmount>0.3</motionBlurAmount>
    <flame>true</flame>
    <flameColor red="255" green="100" blue="50" alpha="255"/>
    <smoke>true</smoke>
    <smokeColor red="230" green="230" blue="230" alpha="102"/>
    <sparks>true</sparks>
    <exhaustScale>1.5</exhaustScale>
    <flameAspectRatio>2.0</flameAspectRatio>
    <sparkConcentration>0.2</sparkConcentration>
    <sparkWeight>0.1</sparkWeight>
    <sky>info.openrocket.swing.gui.figure3d.photo.sky.builtin.Mountains</sky>
  </photostudio>
  <docprefs>
    <pref key="checked" type="boolean">true</pref>
    <pref key="comment" type="string">kitchen &amp; sink</pref>
  </docprefs>

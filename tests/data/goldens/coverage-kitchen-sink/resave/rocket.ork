  <datatypes>
    <type source="customexpression">
      <name>Kinetic energy</name>
      <symbol>Ek</symbol>
      <unit unittype="auto">J</unit>
      <expression>0.5*m*Vt^2</expression>
    </type>
  </datatypes>

  <simulations>
    <simulation status="notsimulated">
      <name>Kitchen sink</name>
      <simulator>RK4Simulator</simulator>
      <calculator>BarrowmanCalculator</calculator>
      <conditions>
        <configid>3e8d1280-53c2-4234-89a7-de215ef5cd69</configid>
        <launchrodlength>1.0</launchrodlength>
        <launchintowind>true</launchintowind>
        <launchrodangle>0.0</launchrodangle>
        <launchroddirection>90.0</launchroddirection>
        <windaverage>2.0</windaverage>
        <windturbulence>0.1</windturbulence>
        <winddirection>1.5707963267948966</winddirection>
        <wind model="average">
          <speed>2.0</speed>
          <direction>1.5707963267948966</direction>
          <standarddeviation>0.2</standarddeviation>
        </wind>
        <wind model="multilevel" altituderef="msl">
          <windlevel altitude="0.0" speed="2.0" direction="1.5707963267948966" standarddeviation="0.1"/>
          <windlevel altitude="150.0" speed="4.5" direction="2.2" standarddeviation="0.3"/>
        </wind>
        <windmodeltype>MultiLevel</windmodeltype>
        <launchaltitude>0.0</launchaltitude>
        <launchlatitude>28.61</launchlatitude>
        <launchlongitude>-80.6</launchlongitude>
        <geodeticmethod>spherical</geodeticmethod>
        <simulationsteppermethod>rk4</simulationsteppermethod>
        <randomseed>-123456789</randomseed>
        <atmosphere model="extendedisa">
          <basetemperature>280.5</basetemperature>
          <basepressure>95000.25</basepressure>
          <baserelativehumidity>0.55</baserelativehumidity>
        </atmosphere>
        <gravity model="constant">
          <value>9.7</value>
        </gravity>
        <timestep>0.01</timestep>
        <maxtime>1200.0</maxtime>
        <recoveryspeedwarning>20.0</recoveryspeedwarning>
        <drogueLowspeedwarning>3.048</drogueLowspeedwarning>
        <recoverydroguemainhighspeedwarning>30.48</recoverydroguemainhighspeedwarning>
        <recoverydroguemainlowspeedwarning>15.24</recoverydroguemainlowspeedwarning>
        <draglookup file="/lookups/drag.csv">
          <row>Mach,AoA,Cd</row>
          <row>0.1,0,0.5</row>
          <row>0.1,4,0.55</row>
          <row>0.8,0,0.6</row>
          <row>0.8,4,0.65</row>
        </draglookup>
        <stabilitylookup>
          <row>Mach;AoA;CN;Cm;Cp</row>
          <row>0.1;0;0.0;0.0;0.4</row>
          <row>0.1;4;0.6;-0.1;0.42</row>
          <row>0.8;0;0.0;0.0;0.41</row>
          <row>0.8;4;0.7;-0.12;0.43</row>
        </stabilitylookup>
      </conditions>
      <landingdispersion runs="750" seed="-5">
        <uncertainty parameter="windspeed" distribution="uniform" spread="1.25"/>
        <uncertainty parameter="airdensity" distribution="lognormal" spread="0.015"/>
      </landingdispersion>
      <plotappearance>
        <series symbol="Vz" linestyle="dotted"/>
        <series symbol="h" linestyle="dashed" red="255" green="0" blue="128" alpha="200"/>
        <series symbol="t" red="0" green="64" blue="0" alpha="255"/>
      </plotappearance>
    </simulation>
  </simulations>
  <photostudio>
    <roll>3.14</roll>
    <yaw>0.25</yaw>
    <pitch>2.05</pitch>
    <advance>0.1</advance>
    <viewAlt>-0.166</viewAlt>

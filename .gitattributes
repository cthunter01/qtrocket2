* text=auto eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
# Gzip fixtures and goldens (tests/data/csv, tests/data/goldens): never a line-end conversion, whatever
# their first bytes look like.
*.gz   binary

# Motor test files whose exact bytes are the point (CRLF and CR line ends, byte-order marks,
# malformed UTF-8): no line-end conversion.
tests/data/motors-edge/** -text

# OpenRocket designs of old file format versions, copied byte for byte from OpenRocket's git history
# (tests/data/ork/README.md lists the size and the SHA-256 of each; three of them are plain XML): no
# line-end conversion.
tests/data/ork/** -text

# A fixture of the command-line tool's test runner whose lines end with "\r\n" on purpose
# (tests/data/cli/README.md): no line-end conversion.
tests/data/cli/crlf-lines.txt -text

# OpenRocket's component preset files (and the openrocket-database's LICENSE and README.md), shipped
# byte for byte as OpenRocket ships them: their SHA-256 are pinned (bundled_preset_files_tests.cpp,
# tests/data/goldens/manifest.json), so git must never convert their line ends.
data/components/** -text

# The .orc fixtures of the component preset loader's tests (tests/data/presets/README.md): the probe
# tools/openrocket-probes/orc-loader prints the size and the SHA-256 of each, which the tests pin.
tests/data/presets/** -text
